# =============================================================================
# Acme Telecom Support Agent: environment template
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in ONE of the two options below (OpenAI or Azure OpenAI).
# 3. Never commit .env (it's already in .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# Option A: OpenAI (default)
# The agent uses gpt-4.1-mini.
# Get a key at https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key


# -----------------------------------------------------------------------------
# Option B: Azure OpenAI / Azure AI Foundry
# To use Azure, uncomment the three lines below and fill them in.
# Leave them commented out when using Option A: if AZURE_OPENAI_ENDPOINT has
# any value, the app uses Azure and ignores OPENAI_API_KEY.
#
# AZURE_OPENAI_ENDPOINT    Your resource endpoint, from the Azure portal
#                          (Keys and Endpoint) or the Foundry project overview.
#                          Either form works:
#                            https://<resource>.services.ai.azure.com/
#                            https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY     Key 1 or Key 2 for that resource.
# AZURE_OPENAI_DEPLOYMENT  The deployment NAME you gave the model (not the
#                          model family), e.g. gpt-5.1 or gpt-4.1-mini.
# -----------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-5.1
